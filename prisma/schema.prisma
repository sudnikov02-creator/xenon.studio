// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Photographer {
  id             String   @id @default(uuid())
  email          String   @unique
  hashedPassword String
  name           String
  phone          String?
  telegramId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
}

model Client {
  id               String               @id @default(uuid())
  telegramId       String?              @unique
  telegramUsername String?
  email            String?              @unique
  phone            String?
  name             String
  avatarUrl        String?
  isVerified       Boolean              @default(false)
  verificationCode String?
  verificationExpiry DateTime?
  
  tags             String[]             // Array of strings or relation
  points           Int                  @default(0)
  loyaltyLevel     LoyaltyLevel         @default(NEWBIE)
  individualDiscount Float              @default(0) // in percentage
  isBlacklisted    Boolean              @default(false)
  
  ltv              Float                @default(0)
  
  bookings         Booking[]
  reviews          Review[]
  loyaltyTx        LoyaltyTransaction[]
  notificationLogs NotificationLog[]
  notes            String?

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

enum LoyaltyLevel {
  NEWBIE
  REGULAR
  VIP
}

model Service {
  id            String         @id @default(uuid())
  name          String
  description   String?
  basePrice     Float
  strikePrice   Float?         // Crossed out price
  duration      Int            // in minutes
  isHidden      Boolean        @default(false)
  minCheck      Float?         // Minimum checkout value
  
  addons        ServiceAddon[]
  promoCodes    PromoCode[]
  bookings      Booking[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

enum AddonType {
  CHECKBOX
  SELECT
  QUANTITY
}

enum AddonPriceType {
  FIXED
  PERCENTAGE
}

model ServiceAddon {
  id          String         @id @default(uuid())
  serviceId   String
  service     Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  
  name        String
  type        AddonType
  priceType   AddonPriceType
  priceValue  Float
  durationMod Int            @default(0) // time added/removed
  
  options     String[]       // for SELECT type
  maxQuantity Int?           // for QUANTITY type
  
  bookingAddons BookingAddon[]
}

model Location {
  id              String    @id @default(uuid())
  name            String
  address         String?
  priceModifier   Float     @default(0) // Fixed addition or percentage? Let's assume fixed for simplicity or percentage based on app logic.
  bufferModifier  Int       @default(0) // Additional minutes for travel
  
  bookings        Booking[]
}

model Booking {
  id              String    @id @default(uuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id])
  serviceId       String
  service         Service   @relation(fields: [serviceId], references: [id])
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id])
  
  statusId        String
  status          Status    @relation(fields: [statusId], references: [id])

  date            DateTime  // Starts at
  duration        Int       // in minutes
  
  basePrice       Float
  totalPrice      Float
  paymentStatus   PaymentStatus @default(UNPAID)
  
  discountApplied Float     @default(0)
  promoCodeId     String?
  promoCode       PromoCode? @relation(fields: [promoCodeId], references: [id])
  pointsUsed      Int       @default(0)
  
  referencesLinks String[]
  photoLinks      String[]
  
  addons          BookingAddon[]
  messages        Message[]
  
  review          Review?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

model BookingAddon {
  id             String       @id @default(uuid())
  bookingId      String
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addonId        String
  addon          ServiceAddon @relation(fields: [addonId], references: [id])
  
  selectedValue  String?      // if SELECT
  quantity       Int?         // if QUANTITY
  priceApplied   Float
}

model Status {
  id               String   @id @default(uuid())
  name             String
  color            String
  icon             String
  isReviewable     Boolean  @default(false)
  cancelPolicy     CancelPolicy @default(FORBIDDEN)
  reschedulePolicy ReschedulePolicy @default(FORBIDDEN)
  
  bookings         Booking[]
  
  transitionsFrom  StatusTransition[] @relation("FromStatus")
  transitionsTo    StatusTransition[] @relation("ToStatus")
}

enum CancelPolicy {
  FREE
  PAID
  FORBIDDEN
}

enum ReschedulePolicy {
  FREE
  PAID
  FORBIDDEN
}

model StatusTransition {
  id           String @id @default(uuid())
  fromStatusId String
  toStatusId   String
  
  fromStatus   Status @relation("FromStatus", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatus     Status @relation("ToStatus", fields: [toStatusId], references: [id], onDelete: Cascade)

  @@unique([fromStatusId, toStatusId])
}

model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  
  rating    Int
  text      String?
  response  String?
  isPublished Boolean @default(false)
  
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  
  sender    SenderType
  text      String
  isRead    Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SenderType {
  CLIENT
  PHOTOGRAPHER
  SYSTEM
}

model PromoCode {
  id          String   @id @default(uuid())
  code        String   @unique
  type        PromoType
  value       Float
  limit       Int?
  used        Int      @default(0)
  expiresAt   DateTime?
  
  services    Service[] // if empty, applies to all
  bookings    Booking[]
  
  createdAt   DateTime @default(now())
}

enum PromoType {
  FIXED
  PERCENTAGE
}

model LoyaltyTransaction {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amount      Int      // positive for accrual, negative for spend
  type        LoyaltyTxType
  description String?
  
  createdAt   DateTime @default(now())
}

enum LoyaltyTxType {
  ACCRUAL
  SPEND
  MANUAL
  EXPIRED
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  trigger   String   @unique
  subject   String?
  body      String
  channels  ChannelType[]
  isActive  Boolean  @default(true)
}

enum ChannelType {
  EMAIL
  TELEGRAM
  SMS
}

model NotificationLog {
  id        String   @id @default(uuid())
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])
  type      String
  status    NotifStatus
  error     String?
  
  createdAt DateTime @default(now())
}

enum NotifStatus {
  SENT
  FAILED
  PENDING
}

model WorkingHours {
  id        String   @id @default(uuid())
  dayOfWeek Int      // 0 = Sunday, 1 = Monday, etc.
  startTime String   // "09:00"
  endTime   String   // "18:00"
  isDayOff  Boolean  @default(false)
}

model BlockedDate {
  id        String   @id @default(uuid())
  date      DateTime
  reason    String?
}

model Settings {
  key       String   @id
  value     String   // JSON string
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String
  details   String?  // JSON
  
  createdAt DateTime @default(now())
}
